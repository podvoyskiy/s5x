# ============================================================
# s5x — TUN Development Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# NOTE: These variables are ONLY used for:
#   - make client-tun
#   - make client-tun-nofake
#   - make clean-routes
#
# ============================================================

# ---------- Required ----------
# SOCKS5 server address (host:port)
SERVER=127.0.0.1:1080

# ---------- Optional ----------
# Authentication (username:password)
AUTH=admin:12345

# XOR obfuscation key
# Must match between client and server
XOR=0xAA

# TUN interface IP address
# Must be a private IP not used elsewhere
TUN_ADDRESS=10.0.0.9

# TUN device name (usually tun0, tun1, etc.)
TUN_DEV=tun0